# Copy this file to .env and replace every example secret before startup.
MYSQL_ROOT_PASSWORD=replace_this_root_password
MYSQL_APP_PASSWORD=replace_this_app_password
REDIS_PASSWORD=replace_this_redis_password
RABBITMQ_PASSWORD=replace_this_rabbitmq_password
# Nacos requires these server-side values even when local client auth is disabled.
NACOS_AUTH_TOKEN=replace_with_base64_encoded_secret_of_at_least_32_bytes
NACOS_AUTH_IDENTITY_VALUE=replace_this_nacos_identity_value
# Generate at least 32 random bytes and Base64-encode them. Do not reuse another secret.
JWT_SECRET_BASE64=replace_with_base64_encoded_random_secret_of_at_least_32_bytes
JWT_ISSUER=https://campus-enroll.local
JWT_AUDIENCE=campus-enroll-api
LEGACY_SYSTEM_API_KEY=replace_this_legacy_system_api_key

# Host-only development ports. Container-to-container ports remain unchanged.
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379
RABBITMQ_HOST_PORT=25672
RABBITMQ_MANAGEMENT_HOST_PORT=25673
NACOS_HTTP_HOST_PORT=18848
NACOS_GRPC_HOST_PORT=19848
NACOS_CONSOLE_HOST_PORT=18080
GATEWAY_HOST_PORT=18000
